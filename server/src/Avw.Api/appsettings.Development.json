{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3307;Database=avw;User=avw;Password=avw"
  },
  "DataProtection": {
    "AllowUnencryptedKeys": true
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/avw",
    "ClientId": "avw-api",
    "ClientSecret": "avw-dev-secret",
    "RequireHttpsMetadata": false
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200"
  },
  "Map": {
    "Basemaps": [
      {
        "id": "vintage",
        "name": "Vintage",
        "style": "https://tiles.hosting.gradata.com.au/styles/vintage/style.json",
        "default": true
      },
      {
        "id": "terrain",
        "name": "Terrain",
        "style": "https://tiles.hosting.gradata.com.au/styles/terrain/style.json"
      },
      {
        "id": "bright",
        "name": "Bright",
        "style": "https://tiles.hosting.gradata.com.au/styles/bright/style.json"
      },
      {
        "id": "positron",
        "name": "Light",
        "style": "https://tiles.hosting.gradata.com.au/styles/positron/style.json"
      },
      {
        "id": "dark-matter",
        "name": "Dark",
        "style": "https://tiles.hosting.gradata.com.au/styles/dark-matter/style.json"
      },
      {
        "id": "satellite",
        "name": "Satellite",
        "tiles": [ "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}" ],
        "attribution": "Esri, Maxar, Earthstar Geographics, and the GIS User Community"
      }
    ],
    "Overlays": [
      {
        "id": "1atf-topo",
        "name": "1ATF topo",
        "tiles": [
          "https://geoserver.hosting.gradata.com.au/geoserver/vietnam/wms?bbox={bbox-epsg-3857}&service=WMS&version=1.1.1&request=GetMap&transparent=true&layers=vietnam:1atf-topo-classic&width=256&height=256&srs=EPSG:3857&format=image/png8"
        ]
      }
    ],
    "Terrain": {
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "encoding": "terrarium",
      "tileSize": 256,
      "maxZoom": 15,
      "exaggeration": 1.5,
      "attribution": "Terrain: Mapzen, AWS Open Data"
    }
  }
}
