  "notable": [
    {
      "id": 10185,
      "url": "/battlemap?incident=10185",
      "dtg": "1965-10-23T08:00:00",
      "why": [
        "first"
      ],
      "role": "Engineer support",
      "ledBy": "1 RAR",
      "operation": "13/65",
      "task": "Deployment",
      "gridRef": "YT109216",
      "friendlyForce": 0,
      "enemyForce": 0,
      "friendlyKilled": 0,
      "friendlyWounded": 0,
      "enemyKilled": 0,
      "enemyWounded": 0,
      "units": [
        "1 APC Troop, Prince of Wales Light Horse Regiment",
        "1 Battalion, Royal Australian Regiment",
        "105 Field Battery, 1 Field Regiment",
        "161 Field Battery, 1 Australian Task Force",
        "3 Field Troop, 1 Field Squadron"
      ],
      "subUnits": [],
      "report": "Operation 13/65 took place from 23 to 26 October 1965. It involved 1 RAR with, under command, 1 APC Tp (PWLH) and 3 Fd Tp (Royal Australian Engineers), with, in direct support 105 Fd Bty (RAA) and 161 Fd Bty (NZ). In support were E/17th Cav (US) and 161 (Indep) Recce Flt. This was a battalion search and destroy operation to extend the 173d Abn Bde area of influence beyond and to the north east of its TAOR based on the Bien Hoa airbase. The operation took place about 18 kilometres northeast of the Bien Hoa base.",
      "archivalSource": "AWM95, item 7/1/35, 1 Battalion Royal Australian Regiment, Narrative Annexes, 1-31 Oct 65, p. 18-19. McNeill, To Long Tan, p. 441."
    },
    {
      "id": 10079,
      "url": "/battlemap?incident=10079",
      "dtg": "1966-01-10T00:00:00",
      "why": [
        "significant"
      ],
      "role": "Engineer support",
      "ledBy": "1 RAR",
      "operation": "1/66",
      "task": "Installation",
      "gridRef": "XT653287",
      "friendlyForce": 100,
      "enemyForce": 0,
      "friendlyKilled": 1,
      "friendlyWounded": 0,
      "enemyKilled": 0,
      "enemyWounded": 0,
      "units": [
        "3 Field Troop, 1 Field Squadron",
        "B Company, 1 Battalion, Royal Australian Regiment"
      ],
      "subUnits": [],
      "report": "Engineers brought forward a Mighty Mite team to blow smoke and CS gas into the tunnels found by B Company and other 1RAR elements on previous days. It was hoped that the smoke forced into the tunnels would reveal where other entrances were located. The CS gas would be used to deny the tunnels to enemy occupation. During an inspection of one of the tunnel entrances, Cpl Bowtell (RAE) was asphixiated by a combination of CS gas and lack of oxygen. He was located in a vertical shaft between the first and second levels of tunnels. In his struggles he had dislodged his respirator and when rescue parties eventually reached him, he was found to be dead. Two other soldiers were badly affected during their attempts to reach Cpl Bowtell and were dusted off. Other important documents were found in the tunnel system including an excellently presented propaganda book of photographs prepared by the Saigon Cholon Gia Dinh Committee. Other caches  were discovered within the B Company perimeter. These included food, documents, and  medical stores. One cache was found in a tunnel entrance with a sophisticated hinged wooden trap door entry. From the trap door, wires led to two booby traps. The booby traps were grenades in plastic bags. Both wires had been pulled but had broken because the grenade pins had been left splayed.",
      "archivalSource": "Major Ian McFarlane\u0027s Operational Analysis is at AWM95, item 7/1/56, 1 Battalion, Royal Australian Regiment, Annexes, 1-31 Jan 1966, p. 12-19."
    },
    {
      "id": 10144,
      "url": "/battlemap?incident=10144",
      "dtg": "1966-03-17T17:10:00",
      "why": [
        "significant"
      ],
      "role": "Engineer support",
